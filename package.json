{
	"name": "jitterbit-teste",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc",
		"start": "node dist/server.js",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:push": "prisma db push"
	},
	"dependencies": {
		"@fastify/jwt": "^10.0.0",
		"@prisma/adapter-pg": "^7.4.2",
		"@prisma/client": "^6.0.0",
		"bcryptjs": "^3.0.3",
		"fastify": "^5.8.2",
		"fastify-plugin": "^5.1.0",
		"pino": "^10.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/bcryptjs": "^3.0.0",
		"@types/node": "^22.10.0",
		"pino-pretty": "^13.1.3",
		"prisma": "^6.0.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"@prisma/client",
			"@prisma/engines",
			"prisma",
			"esbuild"
		]
